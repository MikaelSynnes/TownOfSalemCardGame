@page "/create-session"
@using TownOfSalemCardGame.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client
@using TownOfSalemCardGame.Client.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@inject HttpClient Http
@inject SessionState SessionState
@inject IJSRuntime JS

<h3>Create Session</h3>

@if (SessionId == null)
{
    <div class="card shadow-sm mx-auto" style="max-width: 480px;">
        <div class="card-body">
            <h5 class="card-title mb-3">Start a new game</h5>
            <EditForm Model="sessionRequest" OnValidSubmit="CreateSessionHandler">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label class="form-label">Username:</label>
                    <InputText @bind-Value="sessionRequest.Username" class="form-control" placeholder="Enter your username" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Create Session</button>
            </EditForm>
        </div>
    </div>
}
else
{
    <div class="alert alert-success">
        <strong>Session Created!</strong><br />
        Session ID: <span class="fw-bold">@SessionId</span>
    </div>
    <p>Share this code with others to join your session.</p>
    <button class="btn btn-secondary mt-2" @onclick="RefreshSession">Refresh User List</button>
    <h5 class="mt-4">Participants:</h5>
    @if (Session != null)
    {
        <ul>
            @foreach (var user in @Session.Participants)
            {
                <li>@user</li>
            }
        </ul>
    }
    else
    {
        <p>No participants found.</p>
    }

    @if (SessionId != null && Session != null && Session.ManagerUsername == sessionRequest.Username)
    {
        <h5 class="mt-4">Assign Roles</h5>
        <div class="table-responsive">
            <table class="table table-responsive-cards">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Description</th>
                        <th>Count</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in AvailableRoles)
                    {
                        <tr>
                            <td data-label="Role">@role.Name</td>
                            <td data-label="Description">@role.Description</td>
                            <td data-label="Count">@role.Count</td>
                            <td data-label="Actions">
                                <button class="btn btn-sm btn-secondary me-1" @onclick="() => DecreaseRole(role)">−</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => IncreaseRole(role)">+</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <span class="@(AvailableRoles.Sum(r => r.Count) == (Session?.Participants?.Count ?? 0) ? "text-success" : "text-danger") fw-bold">
                Roles assigned: @AvailableRoles.Sum(r => r.Count) / @(Session?.Participants?.Count ?? 0) players
            </span>
        </div>
        <button class="btn btn-success mt-2" @onclick="StartGame" disabled="@(AvailableRoles.Sum(r => r.Count) != (Session?.Participants?.Count ?? 0) || (Session?.Participants?.Count ?? 0) == 0)">Start Game</button>
    }

    @if (SessionId != null && Session != null && Session.ManagerUsername == sessionRequest.Username && PlayerAssignments != null)
    {
        <div class="alert alert-info mt-4">
            <strong>Player Roles:</strong>
            <div class="table-responsive mt-2">
                <table class="table table-bordered table-responsive-cards">
                    <thead>
                        <tr>
                            <th>Player</th>
                            <th>Role</th>
                            <th>Description</th>
                            <th>States</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in PlayerAssignments)
                        {
                            <tr>
                                <td data-label="Player">@assignment.Player</td>
                                <td data-label="Role">@assignment.Role?.Name</td>
                                <td data-label="Description">@assignment.Role?.Description</td>
                                <td data-label="States">
                                    @if (assignment.States != null && assignment.States.Count > 0)
                                    {
                                        @foreach (var state in assignment.States)
                                        {
                                            var color = AdminStateOptions.FirstOrDefault(opt => opt.State == state).Color ?? "secondary";
                                            <span class="badge bg-@color me-1">@state</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                </td>
                                <td data-label="Actions">
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var (state, color) in AdminStateOptions)
                                        {
                                            <button class="btn btn-sm @(assignment.States != null && assignment.States.Contains(state) ? $"btn-{color}" : "btn-outline-" + color)" @onclick="() => AdminToggleState(assignment, state)">@state</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private SessionRequest sessionRequest = new();
    private string? SessionId;
    private Session? Session;
    private HubConnection? hubConnection;

    // Role selection for manager
    private List<RoleInfo> AvailableRoles = new()
    {
