@page "/create-session"
@using TownOfSalemCardGame.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client
@using TownOfSalemCardGame.Client.Shared
@using TownOfSalemCardGame.Client.Components
@inject HttpClient Http
@inject SessionState SessionState
@inject IJSRuntime JS
@implements IAsyncDisposable

<h3>Create Session</h3>

@if (SessionId == null)
{
    <CreateSessionForm SessionRequest="sessionRequest" OnValidSubmit="CreateSessionHandler" />
}
else
{
    <SessionLobby SessionId="@SessionId" Session="Session" OnRefresh="RefreshSession" />

    @if (Session != null && Session.ManagerUsername == sessionRequest.Username)
    {
        <RoleAssignment AvailableRoles="AvailableRoles"
                        PlayerCount="Session.Participants?.Count ?? 0"
                        OnIncrease="role => { IncreaseRole(role); }"
                        OnDecrease="role => { DecreaseRole(role); }"
                        OnStartGame="StartGame" />
    }

    @if (Session != null && Session.ManagerUsername == sessionRequest.Username && playerAssignments != null)
    {
        <PlayerAssignments Assignments="playerAssignments"
                           OnToggleState="args => AdminToggleState(args.Item1, args.Item2)"
                           OnToggleNecronomicon="assignment => ToggleNecronomicon(assignment)" />
    }
}


