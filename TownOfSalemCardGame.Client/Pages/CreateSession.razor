        new RoleInfo { Name = "Crusader", Description = "Can protect a player and attack one of their visitors each night.", Count = 0 },
        new RoleInfo { Name = "Psychic", Description = "Receives visions at night revealing groups of innocent or evil players.", Count = 0 },
        new RoleInfo { Name = "Trap Master", Description = "Can place a trap on a player that kills and reveals any evil visitor.", Count = 0 },
        new RoleInfo { Name = "Coroner", Description = "Can examine a dead body at night to learn who visited them when they died.", Count = 0 },
        // Mafia
        new RoleInfo { Name = "Mafia", Description = "A member of the mafia. Eliminate citizens and avoid detection.", Count = 0 },
        new RoleInfo { Name = "Godfather", Description = "The leader of the Mafia. Appears innocent to investigations and orders the nightly kill.", Count = 0 },
        new RoleInfo { Name = "Consigliere", Description = "Can investigate a player at night to learn their exact role.", Count = 0 },
        new RoleInfo { Name = "Blackmailer", Description = "Can silence one player each night, preventing them from speaking during the day.", Count = 0 },
        new RoleInfo { Name = "Consort", Description = "Can distract one player each night, preventing them from using their ability.", Count = 0 },
        new RoleInfo { Name = "Framer", Description = "Can frame a player at night, making them appear suspicious to investigators.", Count = 0 },
        new RoleInfo { Name = "Disguiser", Description = "Can disguise themselves as a Town member, making investigators think they are that player.", Count = 0 },
        new RoleInfo { Name = "Forger", Description = "Can forge a player's last will at night, replacing their final message.", Count = 0 },
        new RoleInfo { Name = "Janitor", Description = "Can clean a dead body at night, hiding the victim's role and last will from the town.", Count = 0 },
        new RoleInfo { Name = "Hypnotist", Description = "Can give a player a false feedback message at night to mislead them.", Count = 0 },
        new RoleInfo { Name = "Ambusher", Description = "Can ambush a player's house, killing one of their visitors and revealing the ambush.", Count = 0 },
        // Neutral
        new RoleInfo { Name = "Serial Killer", Description = "A lone killer who eliminates one player each night. Wins alone.", Count = 0 },
        new RoleInfo { Name = "Arsonist", Description = "Can douse players in gasoline and ignite them all at once. Wins alone.", Count = 0 },
        new RoleInfo { Name = "Witch", Description = "Can control a player each night, forcing them to target another.", Count = 0 },
