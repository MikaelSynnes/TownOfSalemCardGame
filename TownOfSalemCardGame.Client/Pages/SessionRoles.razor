@page "/session-roles"
@using TownOfSalemCardGame.Shared
@using TownOfSalemCardGame.Client.Shared
@using TownOfSalemCardGame.Client.Components
@using Microsoft.AspNetCore.SignalR.Client
@inject SessionState SessionState
@inject HttpClient Http
@inject IJSRuntime JS

<h3 class="tos-page-heading">@(SessionState.IsManager ? "Session Overview" : "Your Role")</h3>

@if (SessionState.PlayerAssignments == null || SessionState.PlayerAssignments.Count == 0)
{
    <div class="tos-alert tos-alert-warn">No assignments to display.</div>
}
else if (SessionState.IsManager)
{
    var nightOrder = GetNightPhaseOrder(SessionState.PlayerAssignments);
    if (nightOrder.Count > 0)
    {
        <div class="tc-night-order-panel mb-4">
            <h5 class="tc-night-order-title">🌙 Night Phase Order</h5>
            <p class="tc-night-order-subtitle">Abilities resolve in this order each night (roles in this game only):</p>
            <ol class="tc-night-order-list">
                @foreach (var entry in nightOrder)
                {
                    <li class="tc-night-order-item tc-faction-@entry.Faction">
                        <span class="tc-night-order-icon">@entry.Icon</span>
                        <span class="tc-night-order-role">@entry.RoleName</span>
                        <span class="tc-night-order-action">— @entry.NightAction</span>
                        @if (!string.IsNullOrEmpty(entry.Players))
                        {
                            <span class="tc-night-order-players">(@entry.Players)</span>
                        }
                    </li>
                }
            </ol>
        </div>
    }

    <div class="tc-cards-grid">
        @foreach (var assignment in SessionState.PlayerAssignments)
        {
            var faction = GetFaction(assignment.Role?.Name);
            var isDead = assignment.States != null && assignment.States.Contains("Dead");
            var a = assignment;
            <RoleCard PlayerName="@a.Player"
                      RoleName="@(a.Role?.Name ?? "Unknown")"
                      Description="@a.Role?.Description"
                      Faction="@faction"
                      IsDead="@isDead"
                      States="@a.States"
                      Classic="true">
                <ActionContent>
                    @foreach (var (state, color) in GetStateOptionsForRole(a, SessionState.PlayerAssignments))
                    {
                        var s = state; var c = color;
                        <button class="btn btn-sm @(a.States.Contains(s) ? $"btn-{c}" : "btn-outline-" + c)"
                                @onclick="() => ToggleState(a, s)">
                            @s
                        </button>
                    }
                </ActionContent>
            </RoleCard>
        }
    </div>

    <!-- Reset Night States Button -->
    <div class="tc-admin-send-panel mt-3">
        <button class="btn btn-warning" @onclick="ResetNightStates">🌙 Reset Night States (start next night)</button>
        <small class="text-muted ms-2">Clears: Jailed, On Alert, Protected, Transported, Controlled, Hypnotized, Muted, Crusading, Trapped, Watched, Tracked, Bugged</small>
    </div>

    <!-- Admin Chat Panel -->
    <div class="tc-admin-send-panel mt-4">
        <h5 class="tc-night-order-title">📢 Send Message to Players</h5>
        <div class="tc-admin-send-row">
            <select class="tc-admin-send-select" @bind="chatTarget">
                <option value="">— select player —</option>
                @foreach (var a in SessionState.PlayerAssignments!)
                {
                    <option value="@a.Player">@a.Player (@(a.Role?.Name ?? "?"))</option>
                }
            </select>
            <input class="tc-admin-send-input"
                   placeholder="Type a message…"
                   @bind="chatMessage"
                   @bind:event="oninput"
                   @onkeydown="OnChatKeyDown" />
            <button class="tc-admin-send-btn"
                    @onclick="SendAdminMessage"
                    disabled="@(string.IsNullOrWhiteSpace(chatMessage) || string.IsNullOrWhiteSpace(chatTarget))">
                Send
            </button>
        </div>
        @if (sentMessages.Count > 0)
        {
            <ul class="tc-admin-chat-list mt-2">
                @foreach (var (target, msg) in sentMessages)
                {
                    <li class="tc-admin-chat-msg">
                        <span class="tc-admin-chat-target">@(string.IsNullOrEmpty(target) ? "Everyone" : target):</span>
                        @msg
                    </li>
                }
            </ul>
        }
    </div>
}
else
{
    var myAssignment = SessionState.PlayerAssignments.FirstOrDefault(a => a.Player == SessionState.Username);
    if (myAssignment == null)
    {
        <div class="tos-alert tos-alert-warn">Your role could not be found.</div>
    }
    else
    {
        var faction = GetFaction(myAssignment.Role?.Name);
        var visibleStates = GetVisibleStatesForPlayer(myAssignment.States);
        <div class="tc-reveal-wrap">
            <RoleCard PlayerName="@myAssignment.Player"
                      RoleName="@(myAssignment.Role?.Name ?? "Unknown")"
                      Description="@myAssignment.Role?.Description"
                      Faction="@faction"
                      IsDead="@(myAssignment.States != null && myAssignment.States.Contains("Dead"))"
                      States="@visibleStates" />
        </div>
        @if (visibleStates != null && visibleStates.Count > 0)
        {
            <div class="tc-player-status-panel mt-3">
                <h6 class="tc-night-order-title">⚠️ Your Status</h6>
                <ul class="list-unstyled mb-0">
                    @foreach (var state in visibleStates)
                    {
                        var msg = GetPlayerStateMessage(state);
                        if (msg != null)
                        {
                            <li class="tc-player-status-msg tc-status-@state.ToLower().Replace(" ", "-")">
                                <span class="badge bg-@RoleCard.GetStateColorPublic(state) me-2">@state</span>@msg
                            </li>
                        }
                    }
                </ul>
            </div>
        }
        @if (receivedMessages.Count > 0)
        {
            <div class="tc-admin-chat-box mt-3">
                <h6 class="tc-admin-chat-title">📢 Messages from Host</h6>
                <ul class="tc-admin-chat-list">
                    @foreach (var msg in receivedMessages)
                    {
                        <li class="tc-admin-chat-msg">@msg</li>
                    }
                </ul>
            </div>
        }
    }
}

@code {
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private HubConnection? hubConnection;
    private string chatMessage = string.Empty;
    private string chatTarget = string.Empty;
    private List<(string Target, string Message)> sentMessages = new();
    private List<string> receivedMessages = new();
    private string? _sessionId;

    // Base states every player can have regardless of roles in game
    private static readonly (string State, string Color)[] BaseStateOptions = new[]
    {
        ("Alive", "success"),
        ("Dead",  "danger"),
    };

    // States that are only relevant when a specific role exists anywhere in the session
    private static readonly (string RequiredRole, string State, string Color)[] RoleGatedStates = new[]
    {
        // Muted — caused by Blackmailer only
        ("Blackmailer",    "Muted",         "secondary"),
        // Protected — caused by any protective role

        ("Bodyguard",      "Protected",     "info"),
        ("Crusader",       "Protected",     "info"),
        ("Guardian Angel", "Protected",     "info"),
        ("Trap Master",    "Protected",     "info"),
        ("Survivor",       "Protected",     "info"),
        // Saved — caused by Doctor, Bodyguard or Guardian Angel actually preventing death
        ("Doctor",         "Saved",         "warning"),
        ("Bodyguard",      "Saved",         "warning"),
        ("Guardian Angel", "Saved",         "warning"),
        // Role-specific states
        ("Veteran",        "On Alert",      "warning"),
        ("Arsonist",       "Doused",        "danger"),
        ("Poisoner",       "Poisoned",      "danger"),
        ("Chemist",        "Poisoned",      "danger"),
        ("Chemist",        "Cured",         "success"),
        ("Plaguebearer",   "Infected",      "warning"),
        ("Hex Master",     "Hexed",         "secondary"),
        ("Jailor",         "Jailed",        "secondary"),
        ("Hypnotist",      "Hypnotized",    "secondary"),
        ("Transporter",    "Transported",   "info"),
        ("Framer",         "Framed",        "warning"),
        ("Disguiser",      "Disguised",     "secondary"),
        ("Witch",          "Controlled",    "secondary"),
        ("Coven Leader",   "Controlled",    "secondary"),
        ("Retributionist", "Resurrected",   "info"),
        ("Necromancer",    "Resurrected",   "info"),
        ("Mayor",          "Revealed",      "warning"),
        ("Executioner",    "Target",        "danger"),
        ("Guardian Angel", "GA Target",     "info"),
        ("Survivor",       "Vested",        "success"),
        ("Crusader",       "Crusading",     "info"),
        ("Medusa",         "Stoned",        "secondary"),
        ("Trap Master",    "Trapped",       "warning"),
        ("Pirate",         "Plundered",     "warning"),
        ("Amnesiac",       "Remembered",    "info"),
        ("Spy",            "Bugged",        "secondary"),
        ("Lookout",        "Watched",       "info"),
        ("Tracker",        "Tracked",       "info"),
    };

    private static IEnumerable<(string State, string Color)> GetStateOptionsForRole(
        PlayerRoleAssignment assignment,
        List<PlayerRoleAssignment>? allAssignments)
    {
        // Always show base states
        foreach (var opt in BaseStateOptions)
            yield return opt;

        if (allAssignments == null) yield break;

        var rolesInGame = allAssignments
            .Where(a => a.Role != null)
            .Select(a => a.Role!.Name)
            .ToHashSet();

        var seen = new HashSet<string>();
        foreach (var (requiredRole, state, color) in RoleGatedStates)
        {
            if (!rolesInGame.Contains(requiredRole)) continue;
            if (!seen.Add(state)) continue;   // avoid duplicate buttons when 2 roles grant same state
            yield return (state, color);
        }
    }

    private static readonly HashSet<string> TownRoleNames = new()
    {
        "Townie", "Sheriff", "Doctor", "Investigator", "Escort", "Mayor", "Bodyguard",
        "Vigilante", "Veteran", "Medium", "Retributionist", "Transporter", "Jailor",
        "Tracker", "Lookout", "Spy", "Crusader", "Psychic", "Trap Master", "Coroner"
    };

    private static readonly HashSet<string> MafiaRoleNames = new()
    {
        "Mafia", "Godfather", "Consigliere", "Blackmailer", "Consort", "Framer",
        "Disguiser", "Forger", "Janitor", "Hypnotist", "Ambusher"
    };

    private static readonly HashSet<string> CovenRoleNames = new()
    {
        "Coven Leader", "Medusa", "Necromancer", "Hex Master", "Potion Master", "Poisoner"
    };

    private static string GetFaction(string? roleName)
    {
        if (roleName == null) return "neutral";
        if (TownRoleNames.Contains(roleName)) return "town";
        if (MafiaRoleNames.Contains(roleName)) return "mafia";
        if (CovenRoleNames.Contains(roleName)) return "coven";
        return "neutral";
    }

    private static string GetRoleIcon(string? roleName) => roleName switch
    {
        "Sheriff" or "Investigator" => "🔍",
        "Doctor" => "🩺",
        "Escort" => "💃",
        "Mayor" => "🏛️",
        "Bodyguard" => "🛡️",
        "Vigilante" => "🔫",
        "Veteran" => "⚔️",
        "Medium" => "🔮",
        "Retributionist" => "☀️",
        "Jailor" => "🔒",
        "Transporter" => "🔄",
        "Tracker" or "Lookout" => "👁️",
        "Spy" => "🕵️",
        "Crusader" => "✝️",
        "Psychic" => "🌙",
        "Godfather" => "🌹",
        "Mafia" or "Consigliere" or "Consort" or "Blackmailer" => "🔪",
        "Framer" => "🖼️",
        "Disguiser" => "🎭",
        "Forger" => "📜",
        "Janitor" => "🧹",
        "Serial Killer" => "🔪",
        "Arsonist" => "🔥",
        "Witch" => "🧙",
        "Jester" => "🃏",
        "Executioner" => "⚖️",
        "Amnesiac" => "❓",
        "Guardian Angel" => "😇",
        "Survivor" => "💫",
        "Coven Leader" => "📖",
        "Medusa" => "🐍",
        "Necromancer" => "💀",
        "Hex Master" => "🌀",
        "Potion Master" => "⚗️",
        "Poisoner" => "☠️",
        _ => "🂠"
    };

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _sessionId = query["sessionId"];
        // Fall back to SessionState if the query string was not passed
        if (string.IsNullOrEmpty(_sessionId))
            _sessionId = SessionState.SessionId;
        if (!string.IsNullOrEmpty(_sessionId))
        {
            var assignments = await Http.GetFromJsonAsync<List<TownOfSalemCardGame.Shared.PlayerRoleAssignment>>($"api/session/assignments/{_sessionId}");
            if (assignments != null && assignments.Count > 0)
            {
                SessionState.PlayerAssignments = assignments;
            }
            else
            {
                var session = await Http.GetFromJsonAsync<Session>($"api/session/{_sessionId}");
                if (session != null && session.Assignments != null && session.Assignments.Count > 0)
                {
                    SessionState.PlayerAssignments = session.Assignments;
                }
                else
                {
                    SessionState.PlayerAssignments = new List<TownOfSalemCardGame.Shared.PlayerRoleAssignment>();
                }
            }
        }
        if (SessionState.PlayerAssignments != null)
        {
            foreach (var assignment in SessionState.PlayerAssignments)
            {
                if (assignment.States == null || assignment.States.Count == 0)
                {
                    assignment.States = new HashSet<string> { "Alive" };
                }
            }
        }
        if (!string.IsNullOrEmpty(_sessionId))
        {
            await StartSignalR(_sessionId);
        }
    }

    private string GetSignalRHubUrl()
    {
        var baseUri = Http.BaseAddress?.ToString()?.TrimEnd('/') ?? NavigationManager.BaseUri.TrimEnd('/');
        return $"{baseUri}/sessionHub";
    }

    private async Task StartSignalR(string sessionId)
    {
        var hubUrl = GetSignalRHubUrl();
        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();
        hubConnection.On<string, string?>("AdminMessage", (message, target) =>
        {
            receivedMessages.Add(message);
            StateHasChanged();
        });
        await hubConnection.StartAsync();
        if (SessionState.IsManager)
        {
            // Manager subscribes to session-wide group (to receive role-assign confirmations if needed)
            await hubConnection.InvokeAsync("SubscribeToSession", sessionId);
        }
        else
        {
            // Player subscribes to their personal group to receive admin messages
            var username = SessionState.Username ?? string.Empty;
            await hubConnection.InvokeAsync("SubscribeToSession", $"{sessionId}_{username}");
        }
    }

    private async Task SendAdminMessage()
    {
        if (string.IsNullOrWhiteSpace(chatMessage) || string.IsNullOrWhiteSpace(chatTarget) || string.IsNullOrEmpty(_sessionId))
            return;
        if (hubConnection == null || hubConnection.State != HubConnectionState.Connected)
        {
            await StartSignalR(_sessionId);
        }
        await hubConnection!.InvokeAsync("SendAdminMessage", _sessionId, chatMessage, chatTarget);
        sentMessages.Add((chatTarget, chatMessage));
        chatMessage = string.Empty;
    }

    private async Task OnChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendAdminMessage();
    }

    private record NightOrderEntry(int Priority, string RoleName, string Icon, string Faction, string NightAction, string Players);

    // Standard Town of Salem night priority order (lower number = resolves first)
    private static readonly (string Role, int Priority, string Action)[] NightPriorityTable = new[]
    {
        // Priority 1 – Transporter (swaps happen before everything else)
        ("Transporter",         1,  "Swaps two players, redirecting all actions targeting them"),
        // Priority 2 – Jailor (jails target, may execute)
        ("Jailor",              2,  "Jails a player; can execute them"),
        // Priority 3 – Veteran (goes on alert; kills all visitors)
        ("Veteran",             3,  "Goes on alert and kills any visitor"),
        // Priority 4 – Escort / Consort (roleblock before attacks land)
        ("Escort",              4,  "Roleblocks a player, preventing their ability"),
        ("Consort",             4,  "Roleblocks a player, preventing their ability"),
        // Priority 5 – Witch / Coven Leader (control before actions fire)
        ("Witch",               5,  "Controls a player, forcing them to target another"),
        ("Coven Leader",        5,  "Controls a player; with Necronomicon, also kills them"),
        // Priority 6 – Investigative roles (gather information)
        ("Sheriff",             6,  "Investigates a player for suspicion"),
        ("Investigator",        6,  "Investigates a player for a role clue"),
        ("Consigliere",         6,  "Learns the exact role of a player"),
        ("Lookout",             6,  "Watches a player to see who visits them"),
        ("Tracker",             6,  "Tracks a player to see who they visited"),
        ("Spy",                 6,  "Bugs a player; sees all Mafia chat & visitors"),
        ("Psychic",             6,  "Receives a vision of innocent or evil players"),
        ("Coroner",             6,  "Examines a corpse to learn who visited when they died"),
        // Priority 7 – Protective roles (protect before killers strike)
        ("Doctor",              7,  "Heals a player, preventing death"),
        ("Bodyguard",           7,  "Protects a player; kills their attacker"),
        ("Crusader",            7,  "Protects a player; attacks one of their visitors"),
        ("Trap Master",         7,  "Places a trap that kills and reveals any evil visitor"),
        ("Guardian Angel",      7,  "Protects their assigned target"),
        // Priority 8 – Killers (attacks resolve after protection)
        ("Godfather",           8,  "Orders the Mafia kill"),
        ("Mafioso",             8,  "Carries out the Mafia kill"),
        ("Mafia",               8,  "Carries out a Mafia attack"),
        ("Vigilante",           8,  "Shoots and kills a chosen player"),
        ("Serial Killer",       8,  "Kills a chosen player"),
        ("Arsonist",            8,  "Douses a player in gasoline (or ignites all doused players)"),
        ("Ambusher",            8,  "Ambushes a house; kills a visitor and reveals themselves"),
        ("Pirate",              8,  "Plunders a player for loot"),
        ("Medusa",              8,  "Stone gazes all visitors; with Necronomicon, also attacks remotely"),
        ("Necromancer",         8,  "Uses a dead player's ability to attack someone"),
        ("Potion Master",       8,  "Uses one potion: heal, reveal, or kill"),
        ("Poisoner",            8,  "Poisons a player; they die the following night unless healed"),
        ("Hex Master",          8,  "Hexes a player; when all living players are hexed they all die"),
        ("Plaguebearer",        8,  "Infects a player; infects all if they become Pestilence"),
        // Priority 9 – Support / utility (after kills are decided)
        ("Medium",              9,  "Speaks with the dead and can relay messages to the living"),
        ("Retributionist",      9,  "Resurrects a dead Town member to use their ability once"),
        ("Amnesiac",            9,  "Remembers a dead player's role to become it"),
        ("Janitor",             9,  "Cleans a dead body, hiding role and last will"),
        ("Forger",              9,  "Forges a player's last will with false information"),
        ("Framer",              9,  "Frames a player, making them appear suspicious"),
        ("Disguiser",           9,  "Disguises themselves as a Town member"),
        ("Blackmailer",         9,  "Silences a player so they cannot speak during the day"),
        ("Hypnotist",           9,  "Sends a false feedback message to a player"),
        ("Executioner",         9,  "Works to get their target lynched (no night action)"),
        ("Jester",              9,  "Tries to appear suspicious to get lynched (no night action)"),
        ("Survivor",            9,  "Uses a bulletproof vest to protect themselves"),
        // Priority 10 – Passive / mayor (no active night ability)
        ("Mayor",               10, "No night ability; reveals during the day for extra vote power"),
        ("Townie",              10, "No night ability"),
        ("Hateful Townie",      10, "No night ability"),
        ("Peaceful Townie",     10, "No night ability"),
    };

    private List<NightOrderEntry> GetNightPhaseOrder(List<PlayerRoleAssignment>? assignments)
    {
        if (assignments == null || assignments.Count == 0) return new();

        var lookup = NightPriorityTable.ToDictionary(x => x.Role, x => (x.Priority, x.Action));
        var result = new List<NightOrderEntry>();

        // Group players by role
        var byRole = assignments
            .Where(a => a.Role != null)
            .GroupBy(a => a.Role!.Name)
            .ToDictionary(g => g.Key, g => string.Join(", ", g.Select(a => a.Player ?? "?")));

        foreach (var (roleName, players) in byRole)
        {
            if (!lookup.TryGetValue(roleName, out var info)) continue;
            var faction = GetFaction(roleName);
            var icon = GetRoleIcon(roleName);
            result.Add(new NightOrderEntry(info.Priority, roleName, icon, faction, info.Action, players));
        }

        return result.OrderBy(e => e.Priority).ThenBy(e => e.Faction).ThenBy(e => e.RoleName).ToList();
    }

    // States that only persist for one night/day cycle and should be cleared at the start of each night
    private static readonly HashSet<string> OneNightStates = new()
    {
        "Jailed", "On Alert", "Protected", "Transported", "Controlled",
        "Hypnotized", "Muted", "Crusading", "Trapped", "Watched", "Tracked", "Bugged", "Cured"
    };

    // States the player themselves can feel/know about
    private static readonly HashSet<string> PlayerVisibleStates = new()
    {
        "Dead", "Jailed", "Muted", "Protected", "Saved", "Poisoned", "Cured", "Doused",
        "Hexed", "Infected", "On Alert", "Transported", "Hypnotized",
        "Vested", "Revealed", "Remembered", "Resurrected", "Stoned",
        "Trapped", "Plundered", "Target", "GA Target"
    };

    private static HashSet<string>? GetVisibleStatesForPlayer(HashSet<string>? states)
    {
        if (states == null) return null;
        var filtered = states.Where(s => PlayerVisibleStates.Contains(s)).ToHashSet();
        return filtered.Count > 0 ? filtered : null;
    }

    private static string? GetPlayerStateMessage(string state) => state switch
    {
        "Dead"          => "You are dead. You may no longer participate.",
        "Jailed"        => "You have been jailed tonight. You cannot use your ability and your actions are restricted.",
        "Muted"         => "You have been blackmailed! You cannot speak today or you will be killed.",
        "Protected"     => "Someone is watching over you tonight.",
        "Saved"         => "You were attacked but someone saved your life!",
        "Poisoned"      => "You have been poisoned! You will die tonight unless cured.",
        "Cured"         => "A Chemist has cured your poison. You will survive!",
        "Doused"        => "You smell like gasoline. The Arsonist has doused you!",
        "Hexed"         => "You have been hexed by the Hex Master.",
        "Infected"      => "You have been infected by the Plaguebearer.",
        "On Alert"      => "You are on alert and will kill any visitor tonight.",
        "Transported"   => "You were transported to another location last night.",
        "Hypnotized"    => "You received a false feedback message last night.",
        "Vested"        => "You are wearing a bulletproof vest tonight.",
        "Revealed"      => "You have revealed yourself as Mayor to the town.",
        "Remembered"    => "You have remembered a role and become it.",
        "Resurrected"   => "You have been brought back from the dead.",
        "Stoned"        => "You have been stone gazed by Medusa.",
        "Trapped"       => "You were caught in a Trap Master's trap.",
        "Plundered"     => "You were plundered by the Pirate.",
        "Target"        => "You are the Executioner's target. They want you lynched.",
        "GA Target"     => "A Guardian Angel is watching over you.",
        _               => null
    };

    private void ResetNightStates()
    {
        if (SessionState.PlayerAssignments == null) return;
        foreach (var assignment in SessionState.PlayerAssignments)
        {
            if (assignment.States == null) continue;
            assignment.States = new HashSet<string>(assignment.States.Except(OneNightStates));
        }
        StateHasChanged();
    }

    private void ToggleState(TownOfSalemCardGame.Shared.PlayerRoleAssignment assignment, string state)
    {
        if (assignment.States == null)
            assignment.States = new HashSet<string>();
        bool changed = false;
        if (state == "Alive")
        {
            if (!assignment.States.Contains("Alive")) changed = true;
            assignment.States.Remove("Dead");
            changed |= assignment.States.Add("Alive");
        }
        else if (state == "Dead")
        {
            if (!assignment.States.Contains("Dead")) changed = true;
            assignment.States.Remove("Alive");
            changed |= assignment.States.Add("Dead");
        }
        else
        {
            if (assignment.States.Contains(state))
            {
                assignment.States.Remove(state);
                changed = true;
            }
            else
            {
                assignment.States.Add(state);
                changed = true;
            }
        }
        if (changed)
        {
            assignment.States = new HashSet<string>(assignment.States);
            StateHasChanged();
        }
    }
}
