@page "/session-roles"
@using TownOfSalemCardGame.Shared
@using TownOfSalemCardGame.Client.Shared
@inject SessionState SessionState
@inject HttpClient Http
@inject IJSRuntime JS

<h3>@(SessionState.IsManager ? "Session Overview" : "Your Role")</h3>

@if (SessionState.PlayerAssignments == null || SessionState.PlayerAssignments.Count == 0)
{
    <div class="alert alert-warning">No assignments to display.</div>
}
else if (SessionState.IsManager)
{
    <div class="role-cards-grid">
        @foreach (var assignment in SessionState.PlayerAssignments)
        {
            var faction = GetFaction(assignment.Role?.Name);
            var isDead = assignment.States != null && assignment.States.Contains("Dead");
            <div class="role-card faction-@faction @(isDead ? "state-dead" : "")">
                <div class="role-card-header">
                    <span class="role-card-player">@assignment.Player</span>
                    <span class="role-card-faction-badge">@faction</span>
                </div>
                <div class="role-card-body">
                    <div class="role-card-name">@(assignment.Role?.Name ?? "Unknown")</div>
                    <div class="role-card-desc">@assignment.Role?.Description</div>
                    <div class="role-card-states">
                        @if (assignment.States != null && assignment.States.Count > 0)
                        {
                            @foreach (var state in assignment.States)
                            {
                                var color = StateOptions.FirstOrDefault(opt => opt.State == state).Color ?? "secondary";
                                <span class="badge bg-@color">@state</span>
                            }
                        }
                        else
                        {
                            <span style="color:var(--tos-text-muted);font-size:0.8rem;">No states</span>
                        }
                    </div>
                </div>
                <div class="role-card-actions">
                    @foreach (var (state, color) in StateOptions)
                    {
                        <button class="btn btn-sm @(assignment.States.Contains(state) ? $"btn-{color}" : "btn-outline-" + color)"
                                @onclick="() => ToggleState(assignment, state)">
                            @state
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    var myAssignment = SessionState.PlayerAssignments.FirstOrDefault(a => a.Player == SessionState.Username);
    @if (myAssignment == null)
    {
        <div class="alert alert-warning">Your role could not be found.</div>
    }
    else
    {
        var faction = GetFaction(myAssignment.Role?.Name);
        var roleIcon = GetRoleIcon(myAssignment.Role?.Name);
        <div class="role-reveal-wrap">
            <div class="role-reveal-card faction-@faction">
                <div class="role-reveal-top">
                    <div class="role-reveal-label">Your Role Has Been Revealed</div>
                    <div class="role-reveal-icon">@roleIcon</div>
                    <div class="role-reveal-name">@myAssignment.Role?.Name</div>
                    <span class="role-reveal-faction faction-@faction">@faction</span>
                </div>
                <hr class="role-reveal-divider" />
                <div class="role-reveal-desc">@myAssignment.Role?.Description</div>
                @if (myAssignment.States != null && myAssignment.States.Count > 0)
                {
                    <div class="role-reveal-states">
                        @foreach (var state in myAssignment.States)
                        {
                            var color = StateOptions.FirstOrDefault(opt => opt.State == state).Color ?? "secondary";
                            <span class="badge bg-@color">@state</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private static readonly (string State, string Color)[] StateOptions = new[] {
        ("Alive", "success"),
        ("Dead", "danger"),
        ("Muted", "secondary"),
        ("Protected", "info"),
        ("Saved", "warning")
    };

    private static readonly HashSet<string> TownRoleNames = new()
    {
        "Citizen", "Sheriff", "Doctor", "Investigator", "Escort", "Mayor", "Bodyguard",
        "Vigilante", "Veteran", "Medium", "Retributionist", "Transporter", "Jailor",
        "Tracker", "Lookout", "Spy", "Crusader", "Psychic", "Trap Master", "Coroner"
    };

    private static readonly HashSet<string> MafiaRoleNames = new()
    {
        "Mafia", "Godfather", "Consigliere", "Blackmailer", "Consort", "Framer",
        "Disguiser", "Forger", "Janitor", "Hypnotist", "Ambusher"
    };

    private static readonly HashSet<string> CovenRoleNames = new()
    {
        "Coven Leader", "Medusa", "Necromancer", "Hex Master", "Potion Master", "Poisoner"
    };

    private static string GetFaction(string? roleName)
    {
        if (roleName == null) return "neutral";
        if (TownRoleNames.Contains(roleName)) return "town";
        if (MafiaRoleNames.Contains(roleName)) return "mafia";
        if (CovenRoleNames.Contains(roleName)) return "coven";
        return "neutral";
    }

    private static string GetRoleIcon(string? roleName) => roleName switch
    {
        "Sheriff" or "Investigator" => "🔍",
        "Doctor" => "🩺",
        "Escort" => "💃",
        "Mayor" => "🏛️",
        "Bodyguard" => "🛡️",
        "Vigilante" => "🔫",
        "Veteran" => "⚔️",
        "Medium" => "🔮",
        "Retributionist" => "☀️",
        "Jailor" => "🔒",
        "Transporter" => "🔄",
        "Tracker" or "Lookout" => "👁️",
        "Spy" => "🕵️",
        "Crusader" => "✝️",
        "Psychic" => "🌙",
        "Godfather" => "🌹",
        "Mafia" or "Consigliere" or "Consort" or "Blackmailer" => "🔪",
        "Framer" => "🖼️",
        "Disguiser" => "🎭",
        "Forger" => "📜",
        "Janitor" => "🧹",
        "Serial Killer" => "🔪",
        "Arsonist" => "🔥",
        "Witch" => "🧙",
        "Jester" => "🃏",
        "Executioner" => "⚖️",
        "Amnesiac" => "❓",
        "Guardian Angel" => "😇",
        "Survivor" => "💫",
        "Coven Leader" => "📖",
        "Medusa" => "🐍",
        "Necromancer" => "💀",
        "Hex Master" => "🌀",
        "Potion Master" => "⚗️",
        "Poisoner" => "☠️",
        _ => "🂠"
    };

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var sessionId = query["sessionId"];
        if (!string.IsNullOrEmpty(sessionId))
        {
            var assignments = await Http.GetFromJsonAsync<List<TownOfSalemCardGame.Shared.PlayerRoleAssignment>>($"api/session/assignments/{sessionId}");
            if (assignments != null && assignments.Count > 0)
            {
                SessionState.PlayerAssignments = assignments;
            }
            else
            {
                var session = await Http.GetFromJsonAsync<Session>($"api/session/{sessionId}");
                if (session != null && session.Assignments != null && session.Assignments.Count > 0)
                {
                    SessionState.PlayerAssignments = session.Assignments;
                }
                else
                {
                    SessionState.PlayerAssignments = new List<TownOfSalemCardGame.Shared.PlayerRoleAssignment>();
                }
            }
        }
        if (SessionState.PlayerAssignments != null)
        {
            foreach (var assignment in SessionState.PlayerAssignments)
            {
                if (assignment.States == null || assignment.States.Count == 0)
                {
                    assignment.States = new HashSet<string> { "Alive" };
                }
            }
        }
    }

    private void ToggleState(TownOfSalemCardGame.Shared.PlayerRoleAssignment assignment, string state)
    {
        if (assignment.States == null)
            assignment.States = new HashSet<string>();
        bool changed = false;
        if (state == "Alive")
        {
            if (!assignment.States.Contains("Alive")) changed = true;
            assignment.States.Remove("Dead");
            changed |= assignment.States.Add("Alive");
        }
        else if (state == "Dead")
        {
            if (!assignment.States.Contains("Dead")) changed = true;
            assignment.States.Remove("Alive");
            changed |= assignment.States.Add("Dead");
        }
        else
        {
            if (assignment.States.Contains(state))
            {
                assignment.States.Remove(state);
                changed = true;
            }
            else
            {
                assignment.States.Add(state);
                changed = true;
            }
        }
        if (changed)
        {
            assignment.States = new HashSet<string>(assignment.States);
            StateHasChanged();
        }
    }
}
