@page "/"
@layout MainLayout
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.NavigateTo("/join-session", replace: true);
    }
}

<style>
    .home-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
        padding: 2rem 1rem;
    }

    .home-title {
        font-size: clamp(2rem, 8vw, 3.5rem);
        font-weight: 700;
        margin-bottom: 0;
    }

    .home-subtitle {
        font-size: clamp(1rem, 4vw, 1.5rem);
        color: #6c757d;
        margin-top: 0.25rem;
        margin-bottom: 1rem;
    }

    .home-desc {
        font-size: 1.1rem;
        color: #495057;
        max-width: 400px;
        margin-bottom: 2rem;
    }

    .home-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .home-actions .btn {
        min-width: 160px;
    }
</style>
