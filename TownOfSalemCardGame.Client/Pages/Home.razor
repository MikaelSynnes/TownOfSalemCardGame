@page "/"
@layout HomeLayout
@inject NavigationManager NavigationManager

<PageTitle>Town of Salem Card Game</PageTitle>

<div class="home-hero">
    <header class="home-header">
        <span class="home-icon">⚖️</span>
        <h1 class="home-title">Town of Salem</h1>
        <p class="home-subtitle">Card Game</p>
    </header>

    <p class="home-desc">Gather your townsfolk. Unmask the evil. Survive the night.</p>

    <div class="home-actions">
        <button class="btn-home btn-home-create" @onclick='() => NavigationManager.NavigateTo("/create-session")'>
            ＋ Create Game
        </button>
        <button class="btn-home btn-home-join" @onclick='() => NavigationManager.NavigateTo("/join-session")'>
            ↪ Join Game
        </button>
    </div>
    <div class="home-actions home-actions-secondary">
        <button class="btn-home btn-home-compendium" @onclick='() => NavigationManager.NavigateTo("/help/cards")'>
            📜 View All Roles
        </button>
    </div>
</div>

