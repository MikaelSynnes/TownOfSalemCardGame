@page "/join-session"
@using TownOfSalemCardGame.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using System.Text.Json
@using TownOfSalemCardGame.Client.Shared
@using TownOfSalemCardGame.Client.Components
@inject SessionState SessionState
@inject HttpClient Http
@inject IJSRuntime JS


@switch (currentView)
{
    case ViewState.Form:
        <JoinSessionForm Request="joinRequest"
                         Error="@Error"
                         PreviousSessions="previousSessions"
                         OnSelectPreviousSession="SelectPreviousSession"
                         OnRemovePreviousSession="RemovePreviousSession"
                         OnSubmit="JoinSessionHandler" />
        break;

    case ViewState.Waiting:
        <div class="tos-alert tos-alert-success">
            <strong>Joined Session!</strong><br />
            Session ID: <span class="tos-highlight">@joinRequest.SessionId</span>
        </div>
        <div class="tos-alert tos-alert-info mt-4">
            ⏳ Waiting for host to start the game…
        </div>
        @if (adminMessages.Count > 0)
        {
            <div class="tc-admin-chat-box mt-3">
                <h6 class="tc-admin-chat-title">📢 Messages from Host</h6>
                <ul class="tc-admin-chat-list">
                    @foreach (var msg in adminMessages)
                    {
                        <li class="tc-admin-chat-msg">@msg</li>
                    }
                </ul>
            </div>
        }
        break;

    case ViewState.RoleReveal:
        <div class="tos-alert tos-alert-success">
            <strong>Joined Session!</strong><br />
            Session ID: <span class="tos-highlight">@joinRequest.SessionId</span>
        </div>
        <div class="tc-reveal-wrap">
            <RoleCard PlayerName="@joinRequest.Username"
                      RoleName="@RoleName"
                      Description="@RoleDescription"
                      Faction="@GetFaction(RoleName)"
                      IsDead="@(playerStates.Contains("Dead"))"
                      States="@GetVisiblePlayerStates()" />
        </div>
        @if (playerStates.Contains("Dead"))
        {
            <div class="tc-player-dead-banner mt-3">
                💀 <strong>You are dead.</strong> You may no longer participate in the game.
            </div>
        }
        @if (GetVisiblePlayerStates()?.Where(s => s != "Dead").Any() == true)
        {
            <div class="tc-player-status-panel mt-3">
                <h6 class="tc-night-order-title">⚠️ Your Status</h6>
                <ul class="list-unstyled mb-0">
                    @foreach (var st in GetVisiblePlayerStates()!.Where(s => s != "Dead"))
                    {
                        var stateMsg = GetPlayerStateMessage(st);
                        if (stateMsg != null)
                        {
                            <li class="tc-player-status-msg">
                                <span class="badge bg-@RoleCard.GetStateColorPublic(st) me-2">@st</span>@stateMsg
                            </li>
                        }
                    }
                </ul>
            </div>
        }
        @if (adminMessages.Count > 0)
        {
            <div class="tc-admin-chat-box mt-3">
                <h6 class="tc-admin-chat-title">📢 Messages from Host</h6>
                <ul class="tc-admin-chat-list">
                    @foreach (var msg in adminMessages)
                    {
                        <li class="tc-admin-chat-msg">@msg</li>
                    }
                </ul>
            </div>
        }
        break;
}

@code {
    private enum ViewState { Form, Waiting, RoleReveal }

    private JoinSessionRequest joinRequest = new();
    private ViewState currentView = ViewState.Form;
    private string? Error;
    private string? RoleName;
    private string? RoleDescription;
    private HubConnection? hubConnection;
    private bool IsManager = false;
    private List<JoinSessionForm.PreviousSession> previousSessions = new();
    private List<string> adminMessages = new();
    private HashSet<string> playerStates = new() { "Alive" };

    private static readonly HashSet<string> PlayerVisibleStates = new()
    {
        "Dead", "Jailed", "Muted", "Protected", "Saved", "Poisoned", "Cured", "Doused",
        "Hexed", "Infected", "On Alert", "Transported", "Hypnotized",
        "Vested", "Revealed", "Remembered", "Resurrected", "Stoned",
        "Trapped", "Plundered", "Target", "GA Target"
    };

    private static readonly HashSet<string> OneNightStates = new()
    {
        "Jailed", "On Alert", "Protected", "Transported", "Controlled",
        "Hypnotized", "Muted", "Crusading", "Trapped", "Watched", "Tracked", "Bugged", "Cured"
    };

    private HashSet<string>? GetVisiblePlayerStates()
    {
        var filtered = playerStates.Where(s => PlayerVisibleStates.Contains(s)).ToHashSet();
        return filtered.Count > 0 ? filtered : null;
    }

    private static string? GetPlayerStateMessage(string state) => state switch
    {
        "Dead"        => "You are dead. You may no longer participate.",
        "Jailed"      => "You have been jailed tonight. You cannot use your ability and your actions are restricted.",
        "Muted"       => "You have been blackmailed! You cannot speak today or you will be killed.",
        "Protected"   => "Someone is watching over you tonight.",
        "Saved"       => "You were attacked but someone saved your life!",
        "Poisoned"    => "You have been poisoned! You will die tonight unless cured.",
        "Cured"       => "A Chemist has cured your poison. You will survive!",
        "Doused"      => "You smell like gasoline. The Arsonist has doused you!",
        "Hexed"       => "You have been hexed by the Hex Master.",
        "Infected"    => "You have been infected by the Plaguebearer.",
        "On Alert"    => "You are on alert and will kill any visitor tonight.",
        "Transported" => "You were transported to another location last night.",
        "Hypnotized"  => "You received a false feedback message last night.",
        "Vested"      => "You are wearing a bulletproof vest tonight.",
        "Revealed"    => "You have revealed yourself as Mayor to the town.",
        "Remembered"  => "You have remembered a role and become it.",
        "Resurrected" => "You have been brought back from the dead.",
        "Stoned"      => "You have been stone gazed by Medusa.",
        "Trapped"     => "You were caught in a Trap Master's trap.",
        "Plundered"   => "You were plundered by the Pirate.",
        "Target"      => "You are the Executioner's target. They want you lynched.",
        "GA Target"   => "A Guardian Angel is watching over you.",
        _             => null
    };

    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private static readonly HashSet<string> TownRoleNames = new()
    {
        "Townie", "Hateful Townie", "Peaceful Townie", "Sheriff", "Doctor", "Investigator", "Escort", "Mayor", "Bodyguard",
        "Vigilante", "Veteran", "Medium", "Retributionist", "Transporter", "Jailor",
        "Tracker", "Lookout", "Spy", "Crusader", "Psychic", "Trap Master", "Coroner"
    };

    private static readonly HashSet<string> MafiaRoleNames = new()
    {
        "Mafia", "Godfather", "Consigliere", "Blackmailer", "Consort", "Framer",
        "Disguiser", "Forger", "Janitor", "Hypnotist", "Ambusher"
    };

    private static readonly HashSet<string> CovenRoleNames = new()
    {
        "Coven Leader", "Medusa", "Necromancer", "Hex Master", "Potion Master", "Poisoner"
    };

    private static string GetFaction(string? roleName)
    {
        if (roleName == null) return "neutral";
        if (TownRoleNames.Contains(roleName)) return "town";
        if (MafiaRoleNames.Contains(roleName)) return "mafia";
        if (CovenRoleNames.Contains(roleName)) return "coven";
        return "neutral";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPreviousSessions();
            StateHasChanged();
        }
    }

    private async Task LoadPreviousSessions()
    {
        try
        {
            var result = await JS.InvokeAsync<JsonElement>("previousSessions.getAll");
            previousSessions = new List<JoinSessionForm.PreviousSession>();
            foreach (var item in result.EnumerateArray())
            {
                var sessionId = item.GetProperty("sessionId").GetString() ?? "";
                var username = item.GetProperty("username").GetString() ?? "";
                var savedAt = item.TryGetProperty("savedAt", out var sa) ? sa.GetString() ?? "" : "";
                previousSessions.Add(new JoinSessionForm.PreviousSession(sessionId, username, savedAt));
            }
        }
        catch { previousSessions = new(); }
    }

    private void SelectPreviousSession(JoinSessionForm.PreviousSession session)
    {
        joinRequest.SessionId = session.SessionId;
        joinRequest.Username = session.Username;
        Error = null;
    }

    private async Task RemovePreviousSession(JoinSessionForm.PreviousSession session)
    {
        await JS.InvokeVoidAsync("previousSessions.remove", session.SessionId, session.Username);
        previousSessions.Remove(session);
    }

    private async Task SaveCurrentSession()
    {
        await JS.InvokeVoidAsync("previousSessions.save", joinRequest.SessionId, joinRequest.Username);
        await LoadPreviousSessions();
    }

    private async Task JoinSessionHandler()
    {
        // Try rejoin as manager first
        var rejoinResponse = await Http.PostAsJsonAsync("api/session/rejoin", joinRequest);
        if (rejoinResponse.IsSuccessStatusCode)
        {
            var session = await rejoinResponse.Content.ReadFromJsonAsync<Session>();
            if (session != null && session.ManagerUsername == joinRequest.Username)
            {
                IsManager = true;
                currentView = ViewState.Waiting;
                Error = null;
                SessionState.IsManager = true;
                SessionState.Username = joinRequest.Username;
                SessionState.SessionId = joinRequest.SessionId;
                await SaveCurrentSession();
                await StartSignalR();
                if (session.IsStarted)
                {
                    NavigationManager.NavigateTo($"/session-roles?sessionId={session.SessionId}&username={Uri.EscapeDataString(joinRequest.Username ?? string.Empty)}");
                }
                else
                {
                    NavigationManager.NavigateTo($"/create-session?sessionId={session.SessionId}");
                }
                return;
            }
        }
        // Fallback to normal join for participants
        var response = await Http.PostAsJsonAsync("api/session/join", joinRequest);
        if (response.IsSuccessStatusCode)
        {
            var session = await response.Content.ReadFromJsonAsync<Session>();
            currentView = ViewState.Waiting;
            Error = null;
            SessionState.IsManager = false;
            SessionState.Username = joinRequest.Username;
            SessionState.SessionId = joinRequest.SessionId;
            await SaveCurrentSession();
            await StartSignalR();

            // If game is already started, restore the player's role from existing assignments
            if (session != null && session.IsStarted && session.Assignments != null)
            {
                var existing = session.Assignments.FirstOrDefault(a => a.Player == joinRequest.Username);
                if (existing?.Role != null)
                {
                    RoleName = existing.Role.Name;
                    RoleDescription = existing.Role.Description;
                    currentView = ViewState.RoleReveal;
                    StateHasChanged();
                }
            }
        }
        else
        {
            Error = "Session not found or join failed.";
        }
    }

    private string GetSignalRHubUrl()
    {
        var baseUri = Http.BaseAddress?.ToString()?.TrimEnd('/') ?? NavigationManager.BaseUri.TrimEnd('/');
        var hubUrl = baseUri.Replace("http://", NavigationManager.Uri.StartsWith("https://") ? "https://" : "http://");
        return $"{hubUrl}/sessionHub";
    }

    private async Task StartSignalR()
    {
        var hubUrl = GetSignalRHubUrl();
        _ = JS.InvokeVoidAsync("console.log", $"Connecting to SignalR hub at: {hubUrl}");
        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();
        hubConnection.On<object>("ReceiveRole", (data) =>
        {
            _ = JS.InvokeVoidAsync("console.log", $"SignalR ReceiveRole message received. Raw data: {System.Text.Json.JsonSerializer.Serialize(data)}");
            if (data is System.Text.Json.JsonElement element && element.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                if (element.TryGetProperty("name", out var nameProp))
                    RoleName = nameProp.GetString();
                if (element.TryGetProperty("description", out var descProp))
                    RoleDescription = descProp.GetString();
                currentView = ViewState.RoleReveal;
                StateHasChanged();
            }
        });
        hubConnection.On<string, string?>("AdminMessage", (message, target) =>
        {
            adminMessages.Add(message);
            StateHasChanged();
        });
        hubConnection.On<IEnumerable<string>>("StateUpdated", (states) =>
        {
            InvokeAsync(() =>
            {
                playerStates = new HashSet<string>(states);
                StateHasChanged();
            });
        });
        hubConnection.On<IEnumerable<string>>("NightStatesReset", (clearedStates) =>
        {
            InvokeAsync(() =>
            {
                var cleared = new HashSet<string>(clearedStates);
                playerStates = new HashSet<string>(playerStates.Except(cleared));
                StateHasChanged();
            });
        });
        await hubConnection.StartAsync();
        // Subscribe to personal group (for role reveal) and session-wide group (for admin messages)
        await hubConnection.InvokeAsync("SubscribeToSession", $"{joinRequest.SessionId}_{joinRequest.Username}");
        await hubConnection.InvokeAsync("SubscribeToSessionGroup", joinRequest.SessionId);
    }
}
