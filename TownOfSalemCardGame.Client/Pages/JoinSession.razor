@page "/join-session"
@using TownOfSalemCardGame.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using System.Text.Json
@using TownOfSalemCardGame.Client.Shared
@using TownOfSalemCardGame.Client.Components
@inject SessionState SessionState
@inject HttpClient Http
@inject IJSRuntime JS

<h3 class="tos-page-heading">Join Session</h3>

@if (!Joined)
{
    @if (previousSessions.Count > 0)
    {
        <div class="tos-panel mx-auto mb-4" style="max-width: 480px;">
            <h5 class="tos-panel-title">Previous Sessions</h5>
            <ul class="ps-list">
                @foreach (var session in previousSessions)
                {
                    <li class="ps-item">
                        <button class="ps-select-btn" @onclick="() => SelectPreviousSession(session)">
                            <span class="ps-session-id">@session.SessionId</span>
                            <span class="ps-username">@session.Username</span>
                        </button>
                        <button class="ps-remove-btn" title="Remove" @onclick="() => RemovePreviousSession(session)">✕</button>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="tos-panel mx-auto" style="max-width: 480px;">
        <h5 class="tos-panel-title">Enter session details</h5>
        <EditForm Model="joinRequest" OnValidSubmit="JoinSessionHandler">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="tos-field">
                <label class="tos-label">Session ID</label>
                <InputText @bind-Value="joinRequest.SessionId" class="tos-input" placeholder="Enter session ID" />
            </div>
            <div class="tos-field">
                <label class="tos-label">Username</label>
                <InputText @bind-Value="joinRequest.Username" class="tos-input" placeholder="Enter your username" />
            </div>
            <button type="submit" class="tos-btn-primary w-100">Join Session</button>
        </EditForm>
        @if (Error != null)
        {
            <div class="tos-error mt-3">@Error</div>
        }
    </div>
}
else
{
    <div class="tos-alert tos-alert-success">
        <strong>Joined Session!</strong><br />
        Session ID: <span class="tos-highlight">@joinRequest.SessionId</span>
    </div>
}

@if (Joined && RoleName == null)
{
    <div class="tos-alert tos-alert-info mt-4">
        ⏳ Waiting for host to start the game…
    </div>
}
@if (Joined && RoleName != null)
{
    <div class="tc-reveal-wrap">
        <RoleCard PlayerName="@joinRequest.Username"
                  RoleName="@RoleName"
                  Description="@RoleDescription"
                  Faction="@GetFaction(RoleName)" />
    </div>
}

@code {
    private JoinSessionRequest joinRequest = new();
    private bool Joined = false;
    private string? Error;
    private string? UserRole;
    private string? RoleName;
    private string? RoleDescription;
    private HubConnection? hubConnection;
    private bool IsManager = false;
    private List<PreviousSession> previousSessions = new();

    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private record PreviousSession(string SessionId, string Username, string SavedAt);

    private static readonly HashSet<string> TownRoleNames = new()
    {
        "Citizen", "Sheriff", "Doctor", "Investigator", "Escort", "Mayor", "Bodyguard",
        "Vigilante", "Veteran", "Medium", "Retributionist", "Transporter", "Jailor",
        "Tracker", "Lookout", "Spy", "Crusader", "Psychic", "Trap Master", "Coroner"
    };

    private static readonly HashSet<string> MafiaRoleNames = new()
    {
        "Mafia", "Godfather", "Consigliere", "Blackmailer", "Consort", "Framer",
        "Disguiser", "Forger", "Janitor", "Hypnotist", "Ambusher"
    };

    private static readonly HashSet<string> CovenRoleNames = new()
    {
        "Coven Leader", "Medusa", "Necromancer", "Hex Master", "Potion Master", "Poisoner"
    };

    private static string GetFaction(string? roleName)
    {
        if (roleName == null) return "neutral";
        if (TownRoleNames.Contains(roleName)) return "town";
        if (MafiaRoleNames.Contains(roleName)) return "mafia";
        if (CovenRoleNames.Contains(roleName)) return "coven";
        return "neutral";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPreviousSessions();
            StateHasChanged();
        }
    }

    private async Task LoadPreviousSessions()
    {
        try
        {
            var result = await JS.InvokeAsync<JsonElement>("previousSessions.getAll");
            previousSessions = new List<PreviousSession>();
            foreach (var item in result.EnumerateArray())
            {
                var sessionId = item.GetProperty("sessionId").GetString() ?? "";
                var username = item.GetProperty("username").GetString() ?? "";
                var savedAt = item.TryGetProperty("savedAt", out var sa) ? sa.GetString() ?? "" : "";
                previousSessions.Add(new PreviousSession(sessionId, username, savedAt));
            }
        }
        catch { previousSessions = new(); }
    }

    private void SelectPreviousSession(PreviousSession session)
    {
        joinRequest.SessionId = session.SessionId;
        joinRequest.Username = session.Username;
        Error = null;
    }

    private async Task RemovePreviousSession(PreviousSession session)
    {
        await JS.InvokeVoidAsync("previousSessions.remove", session.SessionId, session.Username);
        previousSessions.Remove(session);
    }

    private async Task SaveCurrentSession()
    {
        await JS.InvokeVoidAsync("previousSessions.save", joinRequest.SessionId, joinRequest.Username);
        await LoadPreviousSessions();
    }

    private async Task JoinSessionHandler()
    {
        // Try rejoin as manager first
        var rejoinResponse = await Http.PostAsJsonAsync("api/session/rejoin", joinRequest);
        if (rejoinResponse.IsSuccessStatusCode)
        {
            var session = await rejoinResponse.Content.ReadFromJsonAsync<Session>();
            if (session != null && session.ManagerUsername == joinRequest.Username)
            {
                IsManager = true;
                Joined = true;
                Error = null;
                SessionState.IsManager = true;
                SessionState.Username = joinRequest.Username;
                await SaveCurrentSession();
                await StartSignalR();
                // Navigate based on game state
                if (session.IsStarted)
                {
                    // Pass sessionId as query parameter to session-roles
                    NavigationManager.NavigateTo($"/session-roles?sessionId={session.SessionId}");
                }
                else
                {
                    // Pass sessionId as query parameter to create-session
                    NavigationManager.NavigateTo($"/create-session?sessionId={session.SessionId}");
                }
                return;
            }
        }
        // Fallback to normal join for participants
        var response = await Http.PostAsJsonAsync("api/session/join", joinRequest);
        if (response.IsSuccessStatusCode)
        {
            var session = await response.Content.ReadFromJsonAsync<Session>();
            Joined = true;
            Error = null;
            SessionState.IsManager = false;
            SessionState.Username = joinRequest.Username;
            await SaveCurrentSession();
            await StartSignalR();

            // If game is already started, restore the player's role from existing assignments
            if (session != null && session.IsStarted && session.Assignments != null)
            {
                var existing = session.Assignments.FirstOrDefault(a => a.Player == joinRequest.Username);
                if (existing?.Role != null)
                {
                    RoleName = existing.Role.Name;
                    RoleDescription = existing.Role.Description;
                    StateHasChanged();
                }
            }
        }
        else
        {
            Error = "Session not found or join failed.";
        }
    }

    private string GetSignalRHubUrl()
    {
        var baseUri = Http.BaseAddress?.ToString()?.TrimEnd('/') ?? NavigationManager.BaseUri.TrimEnd('/');
        var hubUrl = baseUri.Replace("http://", NavigationManager.Uri.StartsWith("https://") ? "https://" : "http://");
        return $"{hubUrl}/sessionHub";
    }

    private async Task StartSignalR()
    {
        var hubUrl = GetSignalRHubUrl();
        _ = JS.InvokeVoidAsync("console.log", $"Connecting to SignalR hub at: {hubUrl}");
        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();
        hubConnection.On<object>("ReceiveRole", (data) =>
        {
            _ = JS.InvokeVoidAsync("console.log", $"SignalR ReceiveRole message received. Raw data: {System.Text.Json.JsonSerializer.Serialize(data)}");
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            if (data is System.Text.Json.JsonElement element && element.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                if (element.TryGetProperty("name", out var nameProp))
                    RoleName = nameProp.GetString();
                if (element.TryGetProperty("description", out var descProp))
                    RoleDescription = descProp.GetString();
                StateHasChanged();
            }
        });
        await hubConnection.StartAsync();
        await hubConnection.InvokeAsync("SubscribeToSession", $"{joinRequest.SessionId}_{joinRequest.Username}");
    }
}
