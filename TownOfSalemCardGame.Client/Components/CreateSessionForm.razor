@using TownOfSalemCardGame.Shared
@using Microsoft.AspNetCore.Components.Forms

<div class="card shadow-sm mx-auto" style="max-width: 480px;">
    <div class="card-body">
        <h5 class="card-title mb-3">Start a new game</h5>
        <EditForm Model="SessionRequest" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-3">
                <label class="form-label">Username:</label>
                <InputText @bind-Value="SessionRequest.Username" class="form-control" placeholder="Enter your username" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Create Session</button>
        </EditForm>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SessionRequest SessionRequest { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnValidSubmit { get; set; }
}
