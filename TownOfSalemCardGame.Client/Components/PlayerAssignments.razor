@using TownOfSalemCardGame.Shared

<div class="tos-panel mt-4">
    <div class="tos-panel-title">⚖️ Player Roles</div>
    <div class="role-cards-grid">
        @foreach (var assignment in Assignments)
        {
            var faction = GetFaction(assignment.Role?.Name);
            var isDead = assignment.States != null && assignment.States.Contains("Dead");
            <div class="role-card faction-@faction @(isDead ? "state-dead" : "")">
                <div class="role-card-header">
                    <span class="role-card-player">@assignment.Player</span>
                    <span class="role-card-faction-badge">@faction</span>
                </div>
                <div class="role-card-body">
                    <div class="role-card-name">@(assignment.Role?.Name ?? "Unknown")</div>
                    <div class="role-card-desc">@assignment.Role?.Description</div>
                    <div class="role-card-states">
                        @if (assignment.States != null && assignment.States.Count > 0)
                        {
                            @foreach (var state in assignment.States)
                            {
                                var color = StateOptions.FirstOrDefault(opt => opt.State == state).Color ?? "secondary";
                                <span class="badge bg-@color">@state</span>
                            }
                        }
                        else
                        {
                            <span style="color:var(--tos-text-muted);font-size:0.8rem;">No states</span>
                        }
                        @if (assignment.HasNecronomicon)
                        {
                            <span class="badge bg-dark" title="Holds the Necronomicon">📖 Necronomicon</span>
                        }
                    </div>
                </div>
                <div class="role-card-actions">
                    @foreach (var (state, color) in StateOptions)
                    {
                        <button class="btn btn-sm @(assignment.States != null && assignment.States.Contains(state) ? $"btn-{color}" : "btn-outline-" + color)"
                                @onclick="() => OnToggleState.InvokeAsync((assignment, state))">
                            @state
                        </button>
                    }
                    @if (IsCovenRole(assignment.Role?.Name))
                    {
                        <button class="btn btn-sm @(assignment.HasNecronomicon ? "btn-dark" : "btn-outline-dark")"
                                @onclick="() => OnToggleNecronomicon.InvokeAsync(assignment)"
                                title="Give or take the Necronomicon">
                            📖 Necronomicon
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<PlayerRoleAssignment> Assignments { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback<(PlayerRoleAssignment, string)> OnToggleState { get; set; }
    [Parameter, EditorRequired] public EventCallback<PlayerRoleAssignment> OnToggleNecronomicon { get; set; }

    public static readonly (string State, string Color)[] StateOptions = new[]
    {
        ("Alive", "success"),
        ("Dead", "danger"),
        ("Muted", "secondary"),
        ("Protected", "info"),
        ("Saved", "warning"),
        ("Doused", "warning"),
        ("Hexed", "purple"),
        ("Poisoned", "dark"),
        ("Jailed", "primary"),
        ("Cleaned", "light")
    };

    private static readonly HashSet<string> TownRoleNames = new()
    {
        "Citizen", "Sheriff", "Doctor", "Investigator", "Escort", "Mayor", "Bodyguard",
        "Vigilante", "Veteran", "Medium", "Retributionist", "Transporter", "Jailor",
        "Tracker", "Lookout", "Spy", "Crusader", "Psychic", "Trap Master", "Coroner"
    };

    private static readonly HashSet<string> MafiaRoleNames = new()
    {
        "Mafia", "Godfather", "Consigliere", "Blackmailer", "Consort", "Framer",
        "Disguiser", "Forger", "Janitor", "Hypnotist", "Ambusher"
    };

    private static readonly HashSet<string> CovenRoleNames = new()
    {
        "Coven Leader", "Medusa", "Necromancer", "Hex Master", "Potion Master", "Poisoner"
    };

    private static string GetFaction(string? roleName)
    {
        if (roleName == null) return "neutral";
        if (TownRoleNames.Contains(roleName)) return "town";
        if (MafiaRoleNames.Contains(roleName)) return "mafia";
        if (CovenRoleNames.Contains(roleName)) return "coven";
        return "neutral";
    }

    private static bool IsCovenRole(string? roleName) =>
        roleName != null && CovenRoleNames.Contains(roleName);
}
