@using TownOfSalemCardGame.Shared

<div class="tos-panel mt-4">
    <div class="tos-panel-title">🃏 Assign Roles</div>
    <div class="ra-table-wrap">
        <table class="ra-table">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Description</th>
                    <th class="ra-col-count">Count</th>
                    <th class="ra-col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in AvailableRoles)
                {
                    <tr class="@(role.Count > 0 ? "ra-row-active" : "")">
                        <td class="ra-cell-name">@role.Name</td>
                        <td class="ra-cell-desc">@role.Description</td>
                        <td class="ra-cell-count">@role.Count</td>
                        <td class="ra-cell-actions">
                            <button class="ra-btn ra-btn-minus" @onclick="() => OnDecrease.InvokeAsync(role)" disabled="@(role.Count == 0)">−</button>
                            <button class="ra-btn ra-btn-plus" @onclick="() => OnIncrease.InvokeAsync(role)">+</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="ra-footer">
        <span class="ra-tally @(TotalAssigned == PlayerCount && PlayerCount > 0 ? "ra-tally-ok" : "ra-tally-bad")">
            Roles assigned: @TotalAssigned / @PlayerCount players
        </span>
        <button class="tos-btn-start"
                @onclick="OnStartGame"
                disabled="@(TotalAssigned != PlayerCount || PlayerCount == 0)">
            ⚔️ Start Game
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<RoleInfo> AvailableRoles { get; set; } = default!;
    [Parameter, EditorRequired] public int PlayerCount { get; set; }
    [Parameter, EditorRequired] public EventCallback<RoleInfo> OnIncrease { get; set; }
    [Parameter, EditorRequired] public EventCallback<RoleInfo> OnDecrease { get; set; }
    [Parameter, EditorRequired] public EventCallback OnStartGame { get; set; }

    private int TotalAssigned => AvailableRoles.Sum(r => r.Count);
}
